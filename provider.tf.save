
terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
      helm = {
      source  = "hashicorp/helm"
      version = "~> 2.0"
      configuration_aliases = [helm]
    }
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = "~> 2.0"
      configuration_aliases = [kubernetes]
    }
}
}
# la région aws ou nous voulons déployer nos différentes ressources

provider "aws" {
   region  = "eu-west-3"
  # profile = "ASMAA" # si on utilise pas de AK et SK pour nous connecter, il faudrait ajouter le profil crée avec AWS configure sso pour pouvoir avoir accès á notre compte aws
   #access_key = "####################" acces crée pour l'utilisateur qui sera utilisé par terraform
   #secret_key = ""#############################" uilisateur qui sera utilisé par terraform
}

# AWS S3 backend to store tf.state file
#first create bucket on aws user interface or aws cli
terraform {
  backend "s3" {
    bucket = "eshop-tf-backend-bucket-asmaa"
    key    = "terraform.tfstate"
    region = "eu-west-3"

  }
}


data "aws_eks_cluster_auth" "default" {
  name = module.eks.eks_cluster_name

}

provider "kubernetes" {
  host                   = module.eks.eks_cluster_endpoint
  cluster_ca_certificate = base64decode(module.eks.eks_cluster_ca)
  
  exec {
    api_version = "client.authentication.k8s.io/v1beta1"
    command     = "aws"
    args = [
      "eks",
      "get-token",
      "--cluster-name",
      module.eks.eks_cluster_name,  
      "--region",
      var.region,
      "--role-arn",
      module.bastion.bastion_admin_policy_arn, # ARN du rôle IAM du bastion
      "--profile",
      "asmaa"
    ]
  }
}


provider "helm" {
  kubernetes {
    host                   = module.eks.eks_cluster_endpoint
    cluster_ca_certificate = base64decode(module.eks.eks_cluster_ca)
    exec {
      api_version = "client.authentication.k8s.io/v1beta1"
      command     = "aws"
      args        = [
        "eks",
        "get-token",
        "--cluster-name",
        data.aws_eks_cluster_auth.default.name,
        "--region",
        "eu-west-3"
      ]
    }
  }
}
################################

